{
  "name": "global-cyber-economic-monitor",
  "version": "2.0.0",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c blue,green \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:gateway": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/gateway/main/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "GCEM_STATIC_DIR=dist node --experimental-strip-types --disable-warning=ExperimentalWarning src/gateway/main/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:sources": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-sources.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && vite build"
  },
  "keywords": [],
  "author": "JotaMarcos",
  "license": "ISC",
  "description": "Monitoramento global de incidentes cibernéticos e estimativa de impacto econômico a partir de fontes públicas de inteligência de ameaças.",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "swagger-ui-dist": "^5.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": "^22.22.2 || >=24.15"
  }
}
